---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { projects } from '../../data/projects';
import { profile } from '../../data/profile';
import { pathTo } from '../../lib/paths';

export const getStaticPaths = (() => {
  const linkedProjects = projects.filter(
    (project) => project.caseStudy || project.website,
  );
  return linkedProjects.flatMap((project, index) =>
    project.caseStudy
      ? [
          {
            params: { slug: project.slug },
            props: {
              project,
              caseStudy: project.caseStudy,
              next:
                linkedProjects.length > 1
                  ? linkedProjects[(index + 1) % linkedProjects.length]
                  : undefined,
            },
          },
        ]
      : [],
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, caseStudy, next } = Astro.props;
const back = pathTo(`#project-${project.slug}`);
---

<BaseLayout
  title={`${project.name} — ${profile.name}`}
  description={caseStudy.description}
  projectName={project.name}
  casePage
>
  <Header />
  <div class="case-stage">
    <main
      class:list={['case wrap', { 'case-overview': caseStudy.overview }]}
      id="main"
      tabindex="-1"
    >
      <a class="link case-link back-link case-back" href={back}
        ><span class="arrow" aria-hidden="true">←</span> Back to projects</a
      >
      {!caseStudy.overview && <p class="eyebrow">{project.context}</p>}
      <div class="case-heading">
        <h1 class="case-title">{project.name}<span class="accent">.</span></h1>
        {
          project.website && (
            <a
              class="link case-link case-website"
              href={project.website}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit website: ${project.name} (opens in a new tab)`}
            >
              Visit website{' '}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )
        }
      </div>
      <p class="case-lead">{caseStudy.lead}</p>
      {
        caseStudy.overview && (
          <>
            <p class="case-story">{caseStudy.overview.story}</p>
            <div class="case-details">
              <ProjectGallery
                id={`gallery-${project.slug}`}
                name={project.name}
                images={caseStudy.overview.images}
              />
              <div class="case-contributions">
                {caseStudy.overview.contributions.map(
                  ({ title, description }, index) => (
                    <section aria-labelledby={`contribution-${index}`}>
                      <h2 id={`contribution-${index}`}>{title}</h2>
                      <p>{description}</p>
                    </section>
                  ),
                )}
              </div>
            </div>
          </>
        )
      }
      {
        caseStudy.role && caseStudy.scope && (
          <dl class="case-meta">
            <div>
              <>
                <dt>Role</dt>
                <dd>{caseStudy.role}</dd>
              </>
            </div>
            <div>
              <>
                <dt>Scope</dt>
                <dd>{caseStudy.scope}</dd>
              </>
            </div>
          </dl>
        )
      }
      {
        caseStudy.result && (
          <section class="result-panel" aria-labelledby="result-title">
            <h2 id="result-title">
              <strong>{caseStudy.result.value}</strong>{' '}
              {caseStudy.result.description}
            </h2>
            <dl class="comparison">
              <div>
                <>
                  <dt>Before</dt>
                  <dd>{caseStudy.result.before}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>After</dt>
                  <dd>{caseStudy.result.after}</dd>
                </>
              </div>
            </dl>
            <p class="comparison-note">{caseStudy.result.unit}</p>
          </section>
        )
      }
      {
        caseStudy.approach && (
          <section class="case-section" aria-labelledby="approach-title">
            <h2 id="approach-title">What changed</h2>
            <p>{caseStudy.approach}</p>
          </section>
        )
      }
      <nav class="case-navigation" aria-label="Project navigation">
        <a class="link case-link back-link" href={back}
          ><span class="arrow" aria-hidden="true">←</span> Back to projects</a
        >
        {
          next && (
            <a
              class="link case-link"
              href={
                next.caseStudy ? pathTo(`projects/${next.slug}/`) : next.website
              }
              target={next.caseStudy ? undefined : '_blank'}
              rel={next.caseStudy ? undefined : 'noopener noreferrer'}
              aria-label={
                next.caseStudy ? undefined : `${next.name} (opens in a new tab)`
              }
            >
              {next.name}{' '}
              <span class="arrow" aria-hidden="true">
                {next.caseStudy ? '→' : '↗'}
              </span>
            </a>
          )
        }
        <a class="link case-link" href={pathTo('#contact')}
          >Contact <span class="arrow" aria-hidden="true">↗</span></a
        >
      </nav>
    </main>
  </div>
</BaseLayout>
<style>
  .case-stage {
    position: relative;
    isolation: isolate;
  }
  .case {
    max-width: 1000px;
    padding-block: 36px 64px;
  }
  .case-overview {
    max-width: 1200px;
  }
  .case-back {
    margin-bottom: 40px;
  }
  .case-overview .case-back {
    margin-bottom: 28px;
    padding-inline: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
  }
  .case-link {
    gap: 14px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    background: #abcaff05;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .case-link .arrow {
    color: var(--accent);
  }
  .case-link:focus-visible {
    border-color: var(--accent);
    background-color: #b9def210;
    color: var(--text);
  }
  .case-website {
    flex-shrink: 0;
    margin-inline-start: auto;
    color: var(--accent);
    border-color: #c3e7ff59;
    background: #101b2ae6;
  }
  .eyebrow {
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  .case-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px 24px;
  }
  .case-title {
    min-width: 0;
    max-width: 100%;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
  }
  /* Trim font leading to align the button with the title's capital letters. */
  .case-heading:has(.case-website) .case-title {
    text-box: trim-both cap alphabetic;
  }
  .case-lead {
    max-width: 60ch;
    margin-top: 28px;
    color: var(--muted);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }
  .case-overview .case-lead {
    max-width: none;
    margin-top: 20px;
    font-size: 1.0625rem;
  }
  .case-story {
    max-width: 68ch;
    margin-top: 28px;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.5;
    letter-spacing: -0.015em;
  }
  .case-details {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    align-items: start;
    gap: 40px;
    margin-top: 36px;
  }
  .case-contributions {
    display: grid;
    gap: 28px;
  }
  .case-contributions section {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .case-contributions h2 {
    margin-bottom: 12px;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .case-contributions p {
    color: var(--muted);
    font-size: 1rem;
  }
  .case-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
    padding-block: 24px;
    border-top: 1px solid #2b374a;
    border-bottom: 1px solid #2b374a;
  }
  dt {
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .case-meta dd {
    font-size: 1rem;
  }
  .case-section {
    margin-top: 56px;
  }
  .case-section h2 {
    margin-bottom: 24px;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
  }
  .case-section > p {
    max-width: 65ch;
    color: var(--muted);
  }
  .result-panel {
    margin-top: 40px;
    padding: 32px;
    background: linear-gradient(115deg, #111b2e, #0b101b);
    border-left: 2px solid var(--accent);
  }
  .result-panel h2 {
    max-width: 28ch;
    margin-bottom: 28px;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.2;
  }
  .result-panel strong {
    display: block;
    margin-bottom: 8px;
    color: var(--accent);
    font-weight: 500;
  }
  .comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .comparison dd {
    font-size: clamp(1.625rem, 4vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .comparison-note {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .case-navigation {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (hover: hover) {
    .case-link:hover {
      color: var(--text);
      border-color: var(--accent);
      background-color: #b9def210;
    }
  }
  @media (max-width: 1199px) {
    .case-details {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .case-contributions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    .case {
      padding-block: 24px 48px;
    }
    .case-title {
      font-size: clamp(2.625rem, 10vw, 4.375rem);
    }
    .case-back {
      margin-bottom: 32px;
    }
    .case-meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 32px;
    }
    .case-section {
      margin-top: 40px;
    }
    .case-contributions {
      grid-template-columns: minmax(0, 1fr);
    }
    .result-panel {
      padding: 24px 20px;
      margin-top: 32px;
    }
    .case-navigation {
      margin-top: 40px;
    }
  }
  @media print {
    .result-panel {
      break-inside: avoid;
      background: var(--surface);
    }
    .case-navigation,
    .case-back {
      display: none;
    }
  }
</style>
