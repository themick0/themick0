---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { projects } from '../../data/projects';
import { profile } from '../../data/profile';
import { pathTo } from '../../lib/paths';

export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next:
        projects.length > 1
          ? projects[(index + 1) % projects.length]
          : undefined,
    },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, next } = Astro.props;
const back = pathTo(`#project-${project.slug}`);
---

<BaseLayout
  title={`${project.name} — ${profile.name}`}
  description={project.description}
  projectName={project.name}
  casePage
>
  <Header />
  <div class="case-stage">
    {
      project.backdrop && (
        <div class="case-backdrop" aria-hidden="true">
          <img
            src={pathTo(project.backdrop.src)}
            width={project.backdrop.width}
            height={project.backdrop.height}
            alt=""
            decoding="async"
          />
        </div>
      )
    }
    <main class="case wrap" id="main" tabindex="-1">
      <a class="link case-link back-link case-back" href={back}
        ><span class="arrow" aria-hidden="true">←</span> Back to projects</a
      >
      <p class="eyebrow">{project.context}</p>
      <div class="case-heading">
        <h1 class="case-title">{project.name}<span class="accent">.</span></h1>
        {
          project.website && (
            <a
              class="link case-link case-website"
              href={project.website}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit website: ${project.name} (opens in a new tab)`}
            >
              Visit website{' '}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )
        }
      </div>
      <p class="case-lead">{project.lead}</p>
      <dl class="case-meta">
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Scope</dt><dd>{project.scope}</dd></div>
      </dl>
      {
        project.result && (
          <section class="result-panel" aria-labelledby="result-title">
            <h2 id="result-title">
              <strong>{project.result.value}</strong>{' '}
              {project.result.description}
            </h2>
            <dl class="comparison">
              <div>
                <>
                  <dt>Before</dt>
                  <dd>{project.result.before}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>After</dt>
                  <dd>{project.result.after}</dd>
                </>
              </div>
            </dl>
            <p class="comparison-note">{project.result.unit}</p>
          </section>
        )
      }
      {
        project.challenge && (
          <section class="case-section" aria-labelledby="challenge-title">
            <h2 id="challenge-title">The challenge</h2>
            <p>{project.challenge}</p>
          </section>
        )
      }
      {
        project.contributions && (
          <section class="case-section" aria-labelledby="contribution-title">
            <h2 id="contribution-title">My contribution</h2>
            <ul class="contributions" role="list">
              {project.contributions.map(({ title, description }) => (
                <li>
                  <h3>{title}</h3>
                  <p>{description}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        project.approach && (
          <section class="case-section" aria-labelledby="approach-title">
            <h2 id="approach-title">What changed</h2>
            <p>{project.approach}</p>
          </section>
        )
      }
      <nav class="case-navigation" aria-label="Project navigation">
        <a class="link case-link back-link" href={back}
          ><span class="arrow" aria-hidden="true">←</span> Back to projects</a
        >
        {
          next && (
            <a class="link case-link" href={pathTo(`projects/${next.slug}/`)}>
              {next.name}{' '}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
        <a class="link case-link" href={pathTo('#contact')}
          >Contact <span class="arrow" aria-hidden="true">↗</span></a
        >
      </nav>
    </main>
  </div>
</BaseLayout>
<style>
  .case-stage {
    position: relative;
    isolation: isolate;
  }
  .case-backdrop {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 820px;
    overflow: clip;
    pointer-events: none;
    user-select: none;
    mask-image: linear-gradient(
      180deg,
      transparent,
      #000 18%,
      #000 52%,
      transparent
    );
  }
  .case-backdrop img {
    position: absolute;
    top: 24px;
    right: -160px;
    width: min(1240px, 110vw);
    height: auto;
    opacity: 0.18;
    filter: saturate(0.7);
    mask-image: linear-gradient(90deg, transparent, #000 55%);
  }
  .case {
    max-width: 1000px;
    padding-block: 36px 64px;
  }
  .case-back {
    margin-bottom: 40px;
  }
  .case-link {
    gap: 14px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    background: #abcaff05;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .case-link .arrow {
    color: var(--accent);
  }
  .case-link:focus-visible {
    border-color: var(--accent);
    background-color: #b9def210;
    color: var(--text);
  }
  .case-website {
    flex-shrink: 0;
    color: var(--accent);
    border-color: #c3e7ff59;
    background: #101b2ae6;
  }
  .eyebrow {
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  .case-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px 24px;
  }
  .case-title {
    min-width: 0;
    max-width: 100%;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
  }
  /* Trim font leading to align the button with the title's capital letters. */
  .case-heading:has(.case-website) .case-title {
    text-box: trim-both cap alphabetic;
  }
  .case-lead {
    max-width: 60ch;
    margin-top: 28px;
    color: var(--muted);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }
  .case-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
    padding-block: 24px;
    border-top: 1px solid #2b374a;
    border-bottom: 1px solid #2b374a;
  }
  dt {
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .case-meta dd {
    font-size: 1rem;
  }
  .case-section {
    margin-top: 56px;
  }
  .case-section h2 {
    margin-bottom: 24px;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
  }
  .case-section > p {
    max-width: 65ch;
    color: var(--muted);
  }
  .contributions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contributions li {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .contributions h3 {
    margin-bottom: 12px;
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
  }
  .contributions p {
    color: var(--muted);
    font-size: 1rem;
  }
  .result-panel {
    margin-top: 40px;
    padding: 32px;
    background: linear-gradient(115deg, #111b2e, #0b101b);
    border-left: 2px solid var(--accent);
  }
  .result-panel h2 {
    max-width: 28ch;
    margin-bottom: 28px;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.2;
  }
  .result-panel strong {
    display: block;
    margin-bottom: 8px;
    color: var(--accent);
    font-weight: 500;
  }
  .comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .comparison dd {
    font-size: clamp(1.625rem, 4vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .comparison-note {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .case-navigation {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (hover: hover) {
    .case-link:hover {
      color: var(--text);
      border-color: var(--accent);
      background-color: #b9def210;
    }
  }
  @media (max-width: 767px) {
    .case-backdrop {
      height: 660px;
    }
    .case-backdrop img {
      top: 32px;
      right: -260px;
      width: 900px;
      opacity: 0.11;
    }
    .case {
      padding-block: 24px 48px;
    }
    .case-title {
      font-size: clamp(2.625rem, 10vw, 4.375rem);
    }
    .case-back {
      margin-bottom: 32px;
    }
    .case-meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 32px;
    }
    .case-section {
      margin-top: 40px;
    }
    .contributions {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .result-panel {
      padding: 24px 20px;
      margin-top: 32px;
    }
    .case-navigation {
      margin-top: 40px;
    }
  }
  @media print {
    .result-panel {
      break-inside: avoid;
      background: var(--surface);
    }
    .case-navigation,
    .case-back,
    .case-backdrop {
      display: none;
    }
  }
</style>
