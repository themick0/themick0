---
import type { Project } from '../data/projects';
interface Props {
  symbol: Project['symbol'];
}
const { symbol } = Astro.props;
---

<span class:list={['project-symbol', symbol]} aria-hidden="true">
  <svg viewBox="0 0 100 100" fill="none">
    {
      symbol === 'atom' && (
        <>
          <circle cx="50" cy="50" r="30" />
          <ellipse
            cx="50"
            cy="50"
            rx="13"
            ry="39"
            transform="rotate(45 50 50)"
          />
          <ellipse
            cx="50"
            cy="50"
            rx="13"
            ry="39"
            transform="rotate(-45 50 50)"
          />
          <circle class="symbol-core" cx="50" cy="50" r="4" />
        </>
      )
    }
    {
      symbol === 'rocket' && (
        <>
          <path d="M37 61C35 42 54 16 85 15c-1 31-27 50-46 48Zm2-20-17 4-9 18 24-2m22 0-4 17-18 9 2-24M62 20l18 18M34 67l-5 4m0-7-10 8m17 0-8 10" />
          <circle cx="62" cy="38" r="8" />
          <circle class="symbol-core" cx="62" cy="38" r="2.5" />
          <path d="M29 71c-9-2-15 8-15 15 7 0 17-6 15-15Z" />
        </>
      )
    }
    {
      symbol === 'prism' && (
        <>
          <path d="m50 10 34 20v40L50 90 16 70V30L50 10Zm0 0v40m34-20L50 50 16 30m34 20v40M16 70l34-20 34 20" />
          <circle class="symbol-core" cx="50" cy="50" r="3.5" />
        </>
      )
    }
    {
      symbol === 'spiral' && (
        <>
          <circle cx="50" cy="50" r="37" stroke-dasharray="2 6" />
          <path d="M50 50c-15 0-20-16-12-26 12-16 40-6 45 15 8 30-22 53-47 42C12 70 8 42 22 23" />
          <path d="M50 50c15 0 20 16 12 26-12 16-40 6-45-15-8-30 22-53 47-42 24 11 28 39 14 58" />
          <circle class="symbol-core" cx="50" cy="50" r="3" />
        </>
      )
    }
    {
      symbol === 'petals' && (
        <>
          {Array.from({ length: 7 }, (_, index) => (
            <polygon
              points="50,50 41,27 50,9 59,27"
              transform={`rotate(${(360 / 7) * index} 50 50)`}
            />
          ))}
          <circle class="symbol-core" cx="50" cy="50" r="3" />
        </>
      )
    }
    {
      symbol === 'rings' && (
        <>
          <circle cx="36" cy="40" r="23" />
          <circle cx="64" cy="40" r="23" />
          <circle cx="50" cy="64" r="23" />
          <circle class="symbol-core" cx="50" cy="48" r="3" />
        </>
      )
    }
    {
      symbol === 'portal' && (
        <>
          <path d="m50 10 40 40-40 40-40-40 40-40Zm0 15 25 25-25 25-25-25 25-25Zm0 15 10 10-10 10-10-10 10-10ZM10 50h30m20 0h30" />
          <circle class="symbol-core" cx="50" cy="50" r="3" />
        </>
      )
    }
    {
      symbol === 'nodes' && (
        <>
          <path d="M50 16 80 33v34L50 84 20 67V33L50 16Zm0 0v68M20 33l60 34M80 33 20 67" />
          <circle cx="50" cy="16" r="6" />
          <circle cx="80" cy="33" r="6" />
          <circle cx="80" cy="67" r="6" />
          <circle cx="50" cy="84" r="6" />
          <circle cx="20" cy="67" r="6" />
          <circle cx="20" cy="33" r="6" />
          <circle class="symbol-core" cx="50" cy="50" r="5" />
        </>
      )
    }
    {
      symbol === 'cycle' && (
        <>
          <circle cx="50" cy="50" r="25" />
          <path d="M19 30a37 37 0 0 1 66 8m-11-4 11 4 3-12M81 70a37 37 0 0 1-66-8m11 4-11-4-3 12M50 29v21l14 9" />
          <circle class="symbol-core" cx="50" cy="50" r="3" />
        </>
      )
    }
  </svg>
</span>
<style>
  .project-symbol {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: radial-gradient(circle, #719ad313, transparent 72%);
  }
  svg {
    width: 90%;
    height: 90%;
    stroke: #9fbed9;
    stroke-width: 0.65;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .symbol-core {
    fill: #c1e3ff;
    stroke: none;
  }
  :is(.rocket, .spiral, .petals, .portal, .cycle) svg {
    stroke: #b7a8db;
  }
  :is(.rocket, .spiral, .petals, .portal, .cycle) .symbol-core {
    fill: #e0caff;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.project-link:hover) svg {
      transform: rotate(24deg);
    }
  }
  @media (max-width: 1023px) {
    .project-symbol {
      width: 68px;
      height: 68px;
    }
  }
  @media (max-width: 767px) {
    .project-symbol {
      width: 50px;
      height: 50px;
      grid-column: 1;
      grid-row: 1;
    }
  }
  @media (max-width: 359px) {
    .project-symbol {
      display: none;
    }
  }
  @media print {
    .project-symbol {
      display: none;
    }
  }
</style>
