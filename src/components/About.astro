---
import StarCluster from './StarCluster.astro';
---

<section class="about" id="about" aria-labelledby="about-title">
  <StarCluster side="right" />
  <h2 class="section-heading" id="about-title">About</h2>
  <div class="about-copy">
    <p class="about-lead">
      Building software products <span class="about-lead-line">
        and automating business workflows with AI.
      </span>
    </p>
    <p class="about-detail">
      I work with teams to understand the problem and define the solution. I
      look for ideas that simplify work and make new products easier to build.
      My focus and expertise lie in DeFi development and business automation. I
      design AI workflows around measurable business outcomes and clear quality
      standards.
    </p>
  </div>
</section>
<style>
  .about {
    position: relative;
    padding-block: 92px 84px;
    border-bottom: 1px solid #7c9cb72e;
  }
  .section-heading {
    margin-bottom: 28px;
  }
  .about-copy {
    max-width: 1000px;
  }
  .about-lead {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .about-lead-line {
    display: block;
  }
  .about-detail {
    max-width: 67ch;
    margin-top: 26px;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  @media (max-width: 767px) {
    .about {
      padding-block: 64px;
    }
    .about-lead {
      font-size: clamp(1.6875rem, 6.9vw, 2.375rem);
    }
    .about-lead-line {
      display: inline;
    }
    .about-detail {
      font-size: 1rem;
    }
  }
</style>
