---
import { profile } from '../data/profile';
---

<footer class="footer wrap">
  <span>{profile.name} / {profile.handle}</span><span
    >© {new Date().getFullYear()}</span
  >
</footer>
<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.025em;
  }
  @media (max-width: 767px) {
    .footer {
      font-size: 0.625rem;
      padding-block: 24px;
    }
  }
</style>
