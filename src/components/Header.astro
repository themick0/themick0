---
import { profile } from '../data/profile';
import { pathTo } from '../lib/paths';
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

<header class:list={['site-header', 'wrap', { 'case-header': !home }]}>
  <div class="brand">
    <svg
      class="brand-star"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      width="32"
      height="32"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M16 3v26M3 16h26M6.8 6.8l18.4 18.4M6.8 25.2 25.2 6.8"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
      <circle cx="16" cy="16" r="3" fill="currentColor"></circle>
    </svg>
    <div class="brand-name">
      <a href={home ? '#top' : pathTo('#top')}>{profile.name}</a>
      <a
        class="handle"
        href={profile.github}
        rel="me"
        aria-label={`${profile.handle} on GitHub`}>{profile.handle}</a
      >
    </div>
  </div>
  <nav aria-label="Main navigation">
    <a href={home ? '#work' : pathTo('#work')}>My work</a>
    <a href={home ? '#contact' : pathTo('#contact')}>Contact</a>
  </nav>
</header>
<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    min-height: 108px;
    padding-block: 18px;
  }
  .case-header {
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding-block: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .brand-star {
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    color: #d3e6fa;
  }
  .brand-name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }
  .brand-name a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    text-decoration: none;
    transition: color 160ms ease-out;
  }
  .brand-name a:focus-visible {
    color: var(--accent);
  }
  .handle {
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 160ms ease-out;
  }
  @media (hover: hover) {
    .brand-name a:hover {
      color: var(--accent);
    }
    nav a:hover {
      color: var(--accent);
    }
  }
  @media (max-width: 1023px) {
    .site-header {
      min-height: 96px;
    }
  }
  @media (max-width: 767px) {
    .site-header {
      min-height: 86px;
      gap: 8px;
      padding-block: 12px;
    }
    .brand {
      gap: 10px;
      font-size: 0.8125rem;
    }
    .brand-star {
      width: 1.5625rem;
      height: 1.5625rem;
    }
    .handle {
      font-size: 0.625rem;
    }
    nav {
      gap: 18px;
    }
    nav a {
      font-size: 0.875rem;
    }
  }
  @media (max-height: 650px) and (min-width: 768px) and (pointer: fine) {
    .site-header {
      min-height: 72px;
      padding-block: 12px;
    }
  }
  @media print {
    nav {
      display: none;
    }
  }
</style>
