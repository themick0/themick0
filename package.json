{
  "name": "themick0-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "validate": "node scripts/validate-build.mjs",
    "test": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json .github/workflows/*.yml",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "cheerio": "^1.1.2",
    "html-validate": "^11.16.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "0.35.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
